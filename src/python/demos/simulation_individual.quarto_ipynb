   "id": "b935818b",
   "metadata": {},
   "source": [
    "---\n",
    "title: \"Individual Simulation Trace — Module-by-Module Metrics\"\n",
    "format: html\n",
    "---\n",
    "\n",
    "## What This Code Does\n",
    "\n",
    "This demo runs **1 agent for 30 days** using the real `StressModel`. After each daily step, it extracts per-phase metrics via `_last_phase_outputs` and organizes them into the 5 modules: stress perception, resilience activation, resource allocation, stress buffering, and daily cycle integration.\n",
    "\n",
    "The theory predicts: challenge/hindrance balance drives stress classification, coping success depends on the C/H ratio modulated by neighbors, resources regenerate with diminishing returns, stress is buffered by available resources, and daily reset pulls affect toward baseline.\n",
    "\n",
    "## Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "setup",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "Environment file /home/lam/data/professional/Documents/academy/_postgrad/PhD-course/2023-pharmaco-economics/journey-log/research/abm-simulation/src/python/demos/.env not found, using system environment variables\n"
     ]
    }
   ],
   "source": [
    "#| label: setup\n",
    "import os\n",
    "import sys\n",
    "import pathlib\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from numpy.random import Generator, PCG64\n",
    "\n",
    "demos_dir = pathlib.Path(os.getcwd())\n",
    "project_root = demos_dir.parents[2]\n",
    "sys.path.insert(0, str(project_root))\n",
    "\n",
    "from src.python.model import StressModel\n",
    "from src.python.demos.module_metrics import (\n",
    "    extract_perception_metrics,\n",
    "    extract_activation_metrics,\n",
    "    extract_allocation_metrics,\n",
    "    extract_buffering_metrics,\n",
    "    extract_daily_cycle_metrics,\n",
    ")\n",
    "\n",
    "_FACTORS = [\"social_support\", \"family_support\", \"formal_intervention\", \"psychological_capital\"]"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "816f32e6",
   "metadata": {},
   "source": [
    "## Run Loop\n",
    "\n",
    "Single agent, 30 days. For each day, collect all phase outputs via `_last_phase_outputs` and extract metrics for each module."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "run",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Recorded 30 days of agent trace\n"
     ]
    }
   ],
   "source": [
    "#| label: run\n",
    "model = StressModel(N=1, max_days=30, seed=42)\n",
    "agent = list(model.agents)[0]\n",
    "\n",
    "records = []\n",
    "\n",
    "for day in range(model.max_days):\n",
    "    # Capture pre-state for daily cycle baseline\n",
    "    pre_state = agent._build_agent_state()\n",
    "\n",
    "    # Execute one day\n",
    "    model.step()\n",
    "\n",
    "    # Read instrumented phase outputs\n",
    "    last = agent._last_phase_outputs\n",
    "\n",
    "    # ── Module 1: Perception (per stress event) ──\n",
    "    for event in agent.last_daily_stress_events:\n",
    "        # Re-extract perception from the last perception output\n",
    "        perception_out = last.get(\"stress_perception\")\n",
    "        if perception_out is not None:\n",
    "            p_metrics = extract_perception_metrics(perception_out, pre_state)\n",
    "        else:\n",
    "            p_metrics = None\n",
    "\n",
    "        # ── Module 2: Activation (if stressed) ──\n",
    "        activation_out = last.get(\"resilience_activation\")\n",
    "        a_metrics = extract_activation_metrics(activation_out, pre_state)\n",
    "\n",
    "    # ── Module 3: Allocation ──\n",
    "    alloc_out = last.get(\"resource_allocation\")\n",
    "    alloc_metrics = extract_allocation_metrics(alloc_out, pre_state)\n",
    "\n",
    "    # ── Module 4: Buffering ──\n",
    "    buff_out = last.get(\"stress_buffering\")\n",
    "    buff_metrics = extract_buffering_metrics(buff_out, pre_state)\n",
    "\n",
    "    # ── Module 5: Daily cycle ──\n",
    "    post_state = agent._build_agent_state()\n",
    "    reset_out = last.get(\"daily_reset\")\n",
    "    affect_out = last.get(\"affect_dynamics\")\n",
    "    pss10_out = last.get(\"pss10_consolidation\")\n",
    "    daily_metrics = extract_daily_cycle_metrics(pre_state, post_state, reset_out, affect_out, pss10_out)\n",
    "\n",
    "    n_events = len(getattr(agent, \"last_daily_stress_events\", []))\n",
    "\n",
    "    records.append({\n",
    "        \"day\": day,\n",
    "        \"affect\": agent.affect,\n",
    "        \"resilience\": agent.resilience,\n",
    "        \"resources\": agent.resources,\n",
    "        \"current_stress\": agent.current_stress,\n",
    "        \"pss10\": agent.pss10,\n",
    "        \"n_events\": n_events,\n",
    "        \"n_interactions\": getattr(agent, \"last_daily_interactions\", 0),\n",
    "        \"n_support\": getattr(agent, \"last_daily_support_exchanges\", 0),\n",
    "        # Allocation metrics\n",
    "        \"regeneration_amount\": alloc_metrics[\"regeneration_amount\"] if alloc_metrics else 0,\n",
    "        \"total_allocated\": alloc_metrics[\"total_allocated\"] if alloc_metrics else 0,\n",
    "        # Buffering metrics\n",
    "        \"buffering_strength\": buff_metrics[\"buffering_strength\"] if buff_metrics else 0,\n",
    "        \"stress_depletion\": buff_metrics[\"stress_depletion\"] if buff_metrics else 0,\n",
    "        # Daily cycle metrics\n",
    "        \"affect_reset_magnitude\": daily_metrics[\"affect_reset_magnitude\"] if daily_metrics else 0,\n",
    "        \"stress_decay_amount\": daily_metrics[\"stress_decay_amount\"] if daily_metrics else 0,\n",
    "        # Activation (last event if any)\n",
    "        \"coped_successfully\": a_metrics[\"coped_successfully\"] if a_metrics else None,\n",
    "        # Perception (last event if any)\n",
    "        \"last_challenge\": p_metrics[\"challenge\"] if p_metrics else 0,\n",
    "        \"last_hindrance\": p_metrics[\"hindrance\"] if p_metrics else 0,\n",
    "    })\n",
    "\n",
    "df_trace = pd.DataFrame(records)\n",
    "print(f\"Recorded {len(df_trace)} days of agent trace\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bb6978a1",
