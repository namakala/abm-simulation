   "source": [
    "#| label: fig-pop-perception\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
    "\n",
    "axes[0].plot(df_agg[\"day\"], df_agg[\"stress_prevalence\"], \"r-\", linewidth=2)\n",
    "axes[0].set_xlabel(\"Day\"); axes[0].set_ylabel(\"Proportion Stressed\")\n",
    "axes[0].set_title(\"Stress Prevalence Over Time\")\n",
    "axes[0].set_ylim(0, 1)\n",
    "\n",
    "# PSS-10 trend\n",
    "pss10_by_day = {d[\"day\"]: [] for d in daily_aggregates}\n",
    "for d in daily_aggregates:\n",
    "    pss10_by_day[d[\"day\"]] = [d[\"daily\"].get(\"pss10_mean\", 15)]\n",
    "\n",
    "axes[1].plot(df_agg[\"day\"], df_agg[\"avg_pss10\"], \"purple\", linewidth=2)\n",
    "axes[1].set_xlabel(\"Day\"); axes[1].set_ylabel(\"Mean PSS-10\")\n",
    "axes[1].set_title(\"Mean PSS-10 Over Time\")\n",
    "\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
