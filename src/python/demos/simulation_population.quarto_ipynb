      }
     },
     "output_type": "display_data"
    }
   ],
   "source": [
    "#| label: fig-pop-buffering\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
    "\n",
    "axes[0].plot(df_agg[\"day\"], df_agg[\"avg_buffering_strength\"], \"g-\", linewidth=2)\n",
    "axes[0].set_xlabel(\"Day\"); axes[0].set_ylabel(\"Mean Buffering Strength\")\n",
    "axes[0].set_title(\"Average Buffering Strength Over Time\")\n",
    "\n",
    "# Buffering vs coping success\n",
    "final_buffering = []\n",
    "final_coping = []\n",
    "for agent in model.agents:\n",
    "    last = agent._last_phase_outputs\n",
    "    buff_out = last.get(\"stress_buffering\")\n",
    "    if buff_out:\n",
    "        final_buffering.append(buff_out[\"observation\"].get(\"buffering_strength\", 0))\n",
    "        events = getattr(agent, \"last_daily_stress_events\", [])\n",
    "        success_rate = sum(1 for e in events if e.get(\"coped_successfully\", False)) / max(len(events), 1)\n",
    "        final_coping.append(success_rate)\n",
    "\n",
    "if final_buffering:\n",
    "    axes[1].scatter(final_buffering, final_coping, alpha=0.6)\n",
    "    axes[1].set_xlabel(\"Buffering Strength\"); axes[1].set_ylabel(\"Coping Success Rate\")\n",
    "    axes[1].set_title(\"Buffering vs Coping (Final Day)\")\n",
    "\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
