   "cell_type": "markdown",
   "id": "21611196",
   "metadata": {},
   "source": [
    "---\n",
    "title: \"Population Simulation Ensemble — Emergent Patterns\"\n",
    "format: html\n",
    "---\n",
    "\n",
    "## What This Code Does\n",
    "\n",
    "This demo runs **50 agents for 30 days** on a Watts-Strogatz small-world network. After each daily step, it extracts per-phase metrics from every agent via `_last_phase_outputs` and computes population-level aggregates for all 5 modules.\n",
    "\n",
    "The theory predicts: stress prevalence fluctuates with event generation, coping success rate is modulated by network structure (well-connected agents cope better), resource inequality emerges from differing stress histories, and affect variance decreases over time as social convergence operates.\n",
    "\n",
    "## Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "setup",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "Environment file /home/lam/data/professional/Documents/academy/_postgrad/PhD-course/2023-pharmaco-economics/journey-log/research/abm-simulation/src/python/demos/.env not found, using system environment variables\n"
     ]
    }
   ],
   "source": [
    "#| label: setup\n",
    "import os\n",
    "import sys\n",
    "import pathlib\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from numpy.random import Generator, PCG64\n",
    "\n",
    "demos_dir = pathlib.Path(os.getcwd())\n",
    "project_root = demos_dir.parents[2]\n",
    "sys.path.insert(0, str(project_root))\n",
    "\n",
    "from src.python.model import StressModel\n",
    "from src.python.demos.module_metrics import (\n",
    "    aggregate_perception,\n",
    "    aggregate_activation,\n",
    "    aggregate_allocation,\n",
    "    aggregate_buffering,\n",
    "    aggregate_daily_cycle,\n",
    "    extract_perception_metrics,\n",
    "    extract_activation_metrics,\n",
    "    extract_allocation_metrics,\n",
    "    extract_buffering_metrics,\n",
    "    extract_daily_cycle_metrics,\n",
    ")\n",
    "\n",
    "_FACTORS = [\"social_support\", \"family_support\", \"formal_intervention\", \"psychological_capital\"]"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d4991c8d",
   "metadata": {},
   "source": [
    "## Run Loop\n",
    "\n",
    "50 agents × 30 days. Per-agent metrics extracted and aggregated each day."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "run",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Population ensemble: 30 days, 50 agents\n"
     ]
    }
   ],
   "source": [
    "#| label: run\n",
    "model = StressModel(N=50, max_days=30, seed=42)\n",
    "\n",
    "daily_aggregates = []\n",
    "\n",
    "for day in range(model.max_days):\n",
    "    model.step()\n",
    "\n",
    "    # Collect per-agent metrics\n",
    "    all_perception = []\n",
    "    all_activation = []\n",
    "    all_allocation = []\n",
    "    all_buffering = []\n",
    "    all_daily = []\n",
    "\n",
    "    for agent in model.agents:\n",
    "        pre_state = agent._build_agent_state()\n",
    "        last = agent._last_phase_outputs\n",
    "\n",
    "        # Extract metrics from each module\n",
    "        p_metrics = extract_perception_metrics(last.get(\"stress_perception\"), pre_state)\n",
    "        a_metrics = extract_activation_metrics(last.get(\"resilience_activation\"), pre_state)\n",
    "        alloc_metrics = extract_allocation_metrics(last.get(\"resource_allocation\"), pre_state)\n",
    "        buff_metrics = extract_buffering_metrics(last.get(\"stress_buffering\"), pre_state)\n",
    "\n",
    "        post_state = agent._build_agent_state()\n",
    "        reset_out = last.get(\"daily_reset\")\n",
    "        affect_out = last.get(\"affect_dynamics\")\n",
    "        pss10_out = last.get(\"pss10_consolidation\")\n",
    "        d_metrics = extract_daily_cycle_metrics(pre_state, post_state, reset_out, affect_out, pss10_out)\n",
    "\n",
    "        if p_metrics: all_perception.append(p_metrics)\n",
    "        if a_metrics: all_activation.append(a_metrics)\n",
    "        if alloc_metrics: all_allocation.append(alloc_metrics)\n",
    "        if buff_metrics: all_buffering.append(buff_metrics)\n",
    "        if d_metrics: all_daily.append(d_metrics)\n",
    "\n",
    "    # Aggregate\n",
    "    daily_aggregates.append({\n",
    "        \"day\": day,\n",
    "        \"perception\": aggregate_perception(all_perception),\n",
    "        \"activation\": aggregate_activation(all_activation),\n",
    "        \"allocation\": aggregate_allocation(all_allocation),\n",
    "        \"buffering\": aggregate_buffering(all_buffering),\n",
    "        \"daily\": aggregate_daily_cycle(all_daily),\n",
    "    })\n",
    "\n",
    "df_agg = pd.DataFrame([\n",
    "    {\"day\": d[\"day\"],\n",
    "     \"stress_prevalence\": d[\"perception\"].get(\"stress_prevalence\", 0),\n",
    "     \"coping_success_rate\": d[\"activation\"].get(\"coping_success_rate\", 0),\n",
    "     \"avg_regeneration\": d[\"allocation\"].get(\"regeneration_mean\", 0),\n",
    "     \"avg_buffering_strength\": d[\"buffering\"].get(\"buffering_strength_mean\", 0),\n",
    "     \"avg_affect_reset\": d[\"daily\"].get(\"affect_reset_magnitude_mean\", 0),\n",
    "     \"avg_stress_decay\": d[\"daily\"].get(\"stress_decay_mean\", 0),\n",
    "     \"avg_pss10\": d[\"daily\"].get(\"pss10_mean\", 15),\n",
    "    }\n",
    "    for d in daily_aggregates\n",
    "])\n",
    "\n",
    "print(f\"Population ensemble: {len(df_agg)} days, {len(model.agents)} agents\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9c0c0b62",
   "metadata": {},
   "source": [
    "## Module 1 — Population Perception: Stress Prevalence"
   ]
  },
  {
