#!/bin/bash
set -e

export DOTENV_FILE=.env.example

echo "==> Running pre-commit checks..."

# Always run lint/format
pixi run format
pixi run lint

# Only run tests if .py files were staged
if git diff --cached --name-only --diff-filter=ACMR | grep -q '\.py$'; then
    pixi run python -m pytest src/python/tests \
        --ignore=src/python/tests/test_integrated_population_theory.py \
        --cov=src/python --cov-report=html --cov-fail-under=85
    pixi run test-config
else
    echo "==> No Python files changed, skipping tests."
fi

# Re-stage files auto-formatted by ruff
git add src/python/

echo "==> All pre-commit checks passed!"
